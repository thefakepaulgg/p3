{
  "name": "@therealpaulgg/p3",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": "github:therealpaulgg/p3",
  "files": [
    "extensions",
    "themes",
    "workflows",
    "scripts/pi-telegram-notify"
  ],
  "pi": {
    "extensions": [
      "./extensions/advisor.ts",
      "./extensions/agent-grants.ts",
      "./extensions/claude-connectors.ts",
      "./extensions/claude-artifacts.ts",
      "./extensions/github-pr-watch.ts",
      "./extensions/jev-compaction.ts",
      "./extensions/model-routing.ts",
      "./extensions/reasoning-ceiling.ts",
      "./extensions/model-style.ts",
      "./extensions/tasks.ts",
      "./extensions/telegram-notify.ts",
      "./extensions/tutor-mode.ts",
      "./extensions/workflow-engine.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "test": "./scripts/test-extensions.sh",
    "test:mcp-events": "node --experimental-strip-types --test extensions/mcp-events/tests/*.test.ts",
    "test:mcp-events:timeout": "MCP_EVENTS_LONG_TEST=1 node --experimental-strip-types --test extensions/mcp-events/tests/timeout.test.ts",
    "typecheck:mcp-events": "tsc -p extensions/mcp-events/tsconfig.json",
    "reference:mcp-events": "node --experimental-strip-types extensions/mcp-events/reference/serve.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "8.20.0",
    "yaml": "^2.9.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
